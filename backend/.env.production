# Production Environment Configuration
# Copy this to .env.production and fill in real values
# NEVER commit .env.production to version control

# ============================================
# SECURITY & SECRETS
# ============================================
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# MUST be at least 32 characters
SECRET_KEY=68d5fe17923177ddf0cbaa5595df0f183f81c02bef4ad0d8a58725f397d81daf
MASTER_KEY=5cfc2a463a279e3e0c04033fcab6a68d9cc637df2d501e01200a4dc7cec3a7ce

# ============================================
# DATABASE
# ============================================
# PostgreSQL production database
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://study_user:your_secure_password@prod-db-host:5432/study_partner_prod

# ============================================
# CORS & FRONTEND
# ============================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=https://app.yourdomain.com,https://www.yourdomain.com

# ============================================
# ENVIRONMENT
# ============================================
# Set to 'production' to disable create_all and use Alembic migrations
ENVIRONMENT=production

# ============================================
# CACHING & RATE LIMITING
# ============================================
# Redis for caching and rate limiting
REDIS_URL=redis://:your_redis_password@redis-prod-host:6379

# ============================================
# API SETTINGS
# ============================================
# Token expiry times
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# LOGGING & MONITORING
# ============================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Sentry DSN for error tracking (optional)
SENTRY_DSN=https://your-sentry-key@sentry.io/project-id

# ============================================
# FILE UPLOADS
# ============================================
# Maximum upload size in bytes (50MB default)
MAX_UPLOAD_SIZE=52428800

# ============================================
# SECURITY HEADERS
# ============================================
# HSTS max age in seconds (1 year default)
HSTS_MAX_AGE=31536000
