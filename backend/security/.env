# AI Study Partner - Environment Configuration Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ============================================
# JWT Configuration
# ============================================
# Generate with: openssl rand -hex 32
SECRET_KEY=1d8ac2c543b4eceb2a49488e4e2ee87a92b95751237fcb58666fc2eeaefeb190
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# Encryption
# ============================================
# Generate with: openssl rand -hex 32
MASTER_KEY=1059ac42546956eb37be3d0d9ab77bd9709f2db015bc5dbd9ce560c3df900e64

# ============================================
# Database Configuration
# ============================================
# PostgreSQL connection string
DATABASE_URL=postgresql://username:password@localhost:5432/study_partner

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ============================================
# Redis Configuration (for rate limiting)
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# File Upload Configuration
# ============================================
# Maximum file size in bytes (50MB)
MAX_UPLOAD_SIZE=52428800

# ============================================
# Email Configuration (for notifications)
# ============================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@studypartner.com

# ============================================
# API Keys (External Services)
# ============================================
# Anthropic API Key
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API Key
OPENAI_API_KEY=sk-...

# Pinecone API Key
PINECONE_API_KEY=...

# ============================================
# Application Configuration
# ============================================
# Environment: development, staging, production
ENVIRONMENT=development

# Debug mode (set to False in production)
DEBUG=True

# Application host and port
APP_HOST=0.0.0.0
APP_PORT=8000

# ============================================
# Logging Configuration
# ============================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path
LOG_FILE=logs/app.log

# ============================================
# Security Configuration
# ============================================
# HTTPS enforcement
FORCE_HTTPS=False

# HSTS max age (in seconds, 1 year = 31536000)
HSTS_MAX_AGE=31536000

# ============================================
# Feature Flags
# ============================================
# Enable two-factor authentication
ENABLE_2FA=False

# Enable biometric tracking
ENABLE_BIOMETRIC_TRACKING=True

# Enable data export
ENABLE_DATA_EXPORT=True

# Enable data deletion
ENABLE_DATA_DELETION=True

# ============================================
# Monitoring & Analytics
# ============================================
# Sentry DSN for error tracking
SENTRY_DSN=

# Google Analytics ID
GOOGLE_ANALYTICS_ID=

# ============================================
# Third-party Services
# ============================================
# AWS Configuration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Cloudflare Configuration
CLOUDFLARE_API_KEY=
CLOUDFLARE_ZONE_ID=

# ============================================
# Notes
# ============================================
# 1. Generate SECRET_KEY and MASTER_KEY with:
#    openssl rand -hex 32
#
# 2. For PostgreSQL, ensure:
#    - Database exists
#    - User has proper permissions
#    - SSL mode is set to 'require' in production
#
# 3. For Redis, ensure:
#    - Redis server is running
#    - Connection is accessible
#
# 4. For email, use app-specific passwords:
#    - Gmail: https://myaccount.google.com/apppasswords
#    - Other providers: Check their documentation
#
# 5. API Keys should be:
#    - Kept secret and never committed
#    - Rotated regularly
#    - Monitored for unauthorized use
#
# 6. In production:
#    - Set DEBUG=False
#    - Set FORCE_HTTPS=True
#    - Use strong, unique passwords
#    - Enable all security features
#    - Set up monitoring and alerting
