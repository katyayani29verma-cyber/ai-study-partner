# Docker Compose environment variables
# This file is loaded automatically by docker-compose

# ============================================
# SECURITY & SECRETS
# ============================================
SECRET_KEY=68d5fe17923177ddf0cbaa5595df0f183f81c02bef4ad0d8a58725f397d81daf
MASTER_KEY=5cfc2a463a279e3e0c04033fcab6a68d9cc637df2d501e01200a4dc7cec3a7ce

# Database password (used by Docker Compose for PostgreSQL)
DB_PASSWORD=MySecurePass123

# Redis password (used by Docker Compose for Redis)
